# ── Core ──────────────────────────────────────────────────────────────────
# "static" (default) reads content from lib/content/static/*.ts and hydrates
# projects from GitHub at build time. "supabase" reads the DB that the /admin
# panel and ingest pipelines write to. See docs/CONTENT.md.
CONTENT_SOURCE=static

# Canonical origin. On Vercel this is derived automatically — only set it for
# a custom domain or local overrides.
# NEXT_PUBLIC_SITE_URL=https://sahil-sanghvi-portfolio.vercel.app

# Optional: a fine-grained read-only GitHub PAT lifts the project/commit
# fetch from 60 req/hr (unauthenticated) to 5000. Not required.
GITHUB_TOKEN=

# Contact form (components/site/pane-contact.tsx). Get a key at resend.com —
# no domain verification needed to start, since RESEND_FROM_EMAIL defaults
# to Resend's own onboarding@resend.dev sender. Without RESEND_API_KEY set,
# the form shows a friendly "email isn't wired up yet" error instead of
# failing hard.
RESEND_API_KEY=
# onboarding@resend.dev is sandboxed: it can only deliver to the email your
# Resend *account* is registered under, not an arbitrary recipient — set
# this to that address (not necessarily profile.public_email). Once a
# custom domain is verified at resend.com/domains, set RESEND_FROM_EMAIL to
# an address on it and RESEND_TO_EMAIL is free to be any inbox.
RESEND_TO_EMAIL=
# RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# ── Automated mode only (CONTENT_SOURCE=supabase) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
CRON_SECRET=

# Resume-parsing provider chain (Groq -> Gemini -> OpenRouter -> OpenAI).
# All optional: a missing key skips that provider in the failover chain.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
